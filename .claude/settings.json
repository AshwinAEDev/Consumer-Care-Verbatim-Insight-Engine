{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "MAX_MCP_OUTPUT_TOKENS": "20000"
  },
  "model": "sonnet",
  "includeGitInstructions": false,
  "enabledPlugins": {
    "mcp-apps@mcp-apps": true,
    "rtk-plugin@enix": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "enix": {
      "source": {
        "source": "github",
        "repo": "enixCode/plugins"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "rtk" }]
      }
    ]
  }
}
