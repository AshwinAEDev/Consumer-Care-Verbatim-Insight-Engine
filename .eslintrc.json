{
    "root":  true,
    "rules":  {
                  "no-console":  [
                                     "warn",
                                     {
                                         "allow":  [
                                                       "warn",
                                                       "error"
                                                   ]
                                     }
                                 ],
                  "no-unused-vars":  "error"
              },
    "parserOptions":  {
                          "ecmaVersion":  2020,
                          "sourceType":  "module"
                      },
    "extends":  [
                    "eslint:recommended"
                ]
}
