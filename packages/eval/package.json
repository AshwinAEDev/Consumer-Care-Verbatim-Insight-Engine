{
    "version":  "0.0.1",
    "name":  "@ccvie/eval",
    "description":  "Evaluation harness",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "type":  "module",
    "scripts":  {
                    "test":  "vitest",
                    "lint":  "eslint src --ext .ts",
                    "build":  "tsup src/index.ts --format esm --dts",
                    "dev":  "tsup src/index.ts --format esm --dts --watch",
                    "type-check":  "tsc --noEmit"
                },
    "dependencies":  {
                         "dotenv":  "^16.3.1"
                     }
}
